includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: max
    # Os testes Pest usam $this dentro de closures, que o PHPStan não resolve; eles são validados pela própria suíte.
    paths:
        - app
        - routes
        - bootstrap
    ignoreErrors:
        # O trait é usado pelos modelos de negócio das próximas entregas (e pelos testes).
        -
            identifier: trait.unused
            path: app/Audit/Audited.php
