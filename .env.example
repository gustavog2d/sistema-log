# Variáveis do Docker Compose (ambiente local). Copie para .env.
API_PORT=8000
WEB_PORT=3000
MAILPIT_PORT=8025
DB_PORT=5432
DB_DATABASE=app
# Papel dono das tabelas (migrations) e papel de runtime da API (sujeito ao RLS).
DB_ADMIN_USERNAME=app
DB_ADMIN_PASSWORD=app
DB_USERNAME=app_runtime
DB_PASSWORD=app_runtime
# Papel das operações de plataforma (cadastro, cobrança).
DB_PLATFORM_USERNAME=app_platform
DB_PLATFORM_PASSWORD=app_platform
# Papel da autenticação do assinante (login, recuperação de senha, 2FA).
DB_AUTH_USERNAME=app_auth
DB_AUTH_PASSWORD=app_auth
# Web: cookies sem Secure só em desenvolvimento local (http). Em produção deixe vazio ou true.
COOKIE_SECURE=false
TRUST_FORWARDED_FOR=false
